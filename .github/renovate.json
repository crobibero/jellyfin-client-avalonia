{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "github>jellyfin/.github//renovate-presets/dotnet"
  ],
  "ignorePaths": [
    "src/global.json"
  ],
  "packageRules": [
    {
      "description": "Group Microsoft dependencies",
      "groupName": "Microsoft",
      "matchPackagePrefixes": [
        "System.",
        "Microsoft."
      ]
    },
    {
      "description": "Group Community Toolkit dependencies",
      "groupName": "CommunityToolkit",
      "matchPackagePrefixes": [
        "CommunityToolkit"
      ]
    },
    {
      "description": "Avalonia, with the StaticLink build of the SkiaSharp version it uses",
      "groupName": "Avalonia",
      "matchPackageNames": [
        "Avalonia*",
        "StaticLink.Avalonia"
      ]
    }
  ]
}
