<controls:PageView x:Class="Jellyfin.Avalonia.Views.HomeView"
                   xmlns="https://github.com/avaloniaui"
                   xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                   xmlns:controls="clr-namespace:Jellyfin.Avalonia.Controls"
                   xmlns:strings="clr-namespace:Jellyfin.Mvvm.Strings;assembly=Jellyfin.Mvvm"
                   xmlns:vm="clr-namespace:Jellyfin.Mvvm.ViewModels;assembly=Jellyfin.Mvvm"
                   x:DataType="vm:HomeViewModel">
    <Grid RowDefinitions="Auto,*">
        <ContentControl Name="Header"
                        Grid.Row="0"
                        Height="230"
                        Classes="browse-header"
                        Content="{Binding}"
                        ContentTemplate="{StaticResource BrowseHeaderTemplate}" />

        <ScrollViewer Grid.Row="1"
                      HorizontalScrollBarVisibility="Disabled">
            <ItemsControl Margin="0,0,0,48"
                          ItemTemplate="{StaticResource CardRowTemplate}"
                          ItemsSource="{Binding Rows}" />
        </ScrollViewer>

        <ProgressBar Grid.Row="1"
                     Width="240"
                     VerticalAlignment="Top"
                     IsIndeterminate="True"
                     IsVisible="{Binding Loading}" />

        <StackPanel Grid.Row="1"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    IsVisible="{Binding HasError}"
                    Spacing="16">
            <TextBlock Classes="error"
                       Text="{Binding ErrorMessage}"
                       TextAlignment="Center" />
            <Button HorizontalAlignment="Center"
                    controls:PageView.IsInitialFocus="True"
                    Command="{Binding RetryCommand}"
                    Content="{x:Static strings:Strings.Retry}" />
        </StackPanel>
    </Grid>
</controls:PageView>
