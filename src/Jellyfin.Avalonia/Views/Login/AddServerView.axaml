<controls:PageView x:Class="Jellyfin.Avalonia.Views.Login.AddServerView"
                   xmlns="https://github.com/avaloniaui"
                   xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                   xmlns:controls="clr-namespace:Jellyfin.Avalonia.Controls"
                   xmlns:icons="https://github.com/oneo-me/fluentui-icons-like"
                   xmlns:strings="clr-namespace:Jellyfin.Mvvm.Strings;assembly=Jellyfin.Mvvm"
                   xmlns:vm="clr-namespace:Jellyfin.Mvvm.ViewModels.Login;assembly=Jellyfin.Mvvm"
                   x:DataType="vm:AddServerViewModel"
                   Background="{DynamicResource StartupBackgroundBrush}">
    <ScrollViewer>
        <StackPanel MaxWidth="520"
                    Margin="24,48"
                    VerticalAlignment="Center"
                    Spacing="24">
            <Image Height="56"
                   HorizontalAlignment="Center"
                   Source="{StaticResource JellyfinLogoImage}" />
            <TextBlock HorizontalAlignment="Center"
                       Classes="h1"
                       Text="{x:Static strings:Strings.Login_AddServer}" />

            <TextBlock Classes="caption"
                       Text="{x:Static strings:Strings.Login_ServerUrl}" />
            <TextBox Name="AddressBox"
                     controls:PageView.IsInitialFocus="True"
                     PlaceholderText="{x:Static strings:Strings.Login_ServerUrlHint}"
                     Text="{Binding ServerUrl}">
                <TextBox.InnerLeftContent>
                    <icons:FluentIcon Width="22"
                                      Height="22"
                                      Margin="16,0,0,0"
                                      Size="Size20"
                                      Symbol="Link" />
                </TextBox.InnerLeftContent>
                <TextBox.KeyBindings>
                    <KeyBinding Command="{Binding ConnectCommand}"
                                Gesture="Enter" />
                </TextBox.KeyBindings>
            </TextBox>

            <TextBlock Classes="error"
                       IsVisible="{Binding HasError}"
                       Text="{Binding ErrorMessage}" />

            <ProgressBar IsIndeterminate="True"
                         IsVisible="{Binding ConnectCommand.IsRunning}" />

            <StackPanel HorizontalAlignment="Center"
                        Orientation="Horizontal"
                        Spacing="16">
                <Button Command="{Binding GoBackCommand}"
                        Content="{x:Static strings:Strings.Back}" />
                <Button Classes="accent"
                        Command="{Binding ConnectCommand}"
                        Content="{x:Static strings:Strings.Login_ConnectButton}" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</controls:PageView>
