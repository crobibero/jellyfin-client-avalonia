<controls:PageView x:Class="Jellyfin.Avalonia.Views.Login.LoginView"
                   xmlns="https://github.com/avaloniaui"
                   xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                   xmlns:controls="clr-namespace:Jellyfin.Avalonia.Controls"
                   xmlns:mi="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
                   xmlns:strings="clr-namespace:Jellyfin.Mvvm.Strings;assembly=Jellyfin.Mvvm"
                   xmlns:vm="clr-namespace:Jellyfin.Mvvm.ViewModels.Login;assembly=Jellyfin.Mvvm"
                   x:DataType="vm:LoginViewModel"
                   Background="{DynamicResource StartupBackgroundBrush}">
    <ScrollViewer>
        <StackPanel MaxWidth="480"
                    Margin="24,48"
                    VerticalAlignment="Center"
                    Spacing="16">
            <Image Height="56"
                   HorizontalAlignment="Center"
                   Source="{StaticResource JellyfinLogoImage}" />
            <TextBlock HorizontalAlignment="Center"
                       Classes="h2"
                       Text="{Binding Title}"
                       TextAlignment="Center"
                       TextWrapping="Wrap" />

            <StackPanel IsVisible="{Binding !IsQuickConnectActive}"
                        Spacing="16">
                <TextBox Name="UsernameBox"
                         controls:PageView.IsInitialFocus="True"
                         PlaceholderText="{x:Static strings:Strings.Login_Username}"
                         Text="{Binding Username}">
                    <TextBox.InnerLeftContent>
                        <mi:MaterialIcon Width="22"
                                         Height="22"
                                         Margin="16,0,0,0"
                                         Kind="AccountOutline" />
                    </TextBox.InnerLeftContent>
                </TextBox>
                <TextBox Name="PasswordBox"
                         PasswordChar="•"
                         PlaceholderText="{x:Static strings:Strings.Login_Password}"
                         RevealPassword="{Binding #RevealToggle.IsChecked}"
                         Text="{Binding Password}">
                    <TextBox.InnerLeftContent>
                        <mi:MaterialIcon Width="22"
                                         Height="22"
                                         Margin="16,0,0,0"
                                         Kind="LockOutline" />
                    </TextBox.InnerLeftContent>
                    <TextBox.InnerRightContent>
                        <ToggleButton Name="RevealToggle"
                                      Margin="0,0,8,0"
                                      Background="Transparent"
                                      BorderThickness="0">
                            <mi:MaterialIcon Width="20"
                                             Height="20"
                                             Kind="EyeOutline" />
                        </ToggleButton>
                    </TextBox.InnerRightContent>
                    <TextBox.KeyBindings>
                        <KeyBinding Command="{Binding LoginCommand}"
                                    Gesture="Enter" />
                    </TextBox.KeyBindings>
                </TextBox>

                <CheckBox Content="{x:Static strings:Strings.Login_RememberMe}"
                          IsChecked="{Binding RememberMe}" />

                <TextBlock Classes="error"
                           IsVisible="{Binding HasError}"
                           Text="{Binding ErrorMessage}" />

                <ProgressBar IsIndeterminate="True"
                             IsVisible="{Binding IsSigningIn}" />

                <Button HorizontalAlignment="Stretch"
                        Classes="accent"
                        Command="{Binding LoginCommand}"
                        Content="{x:Static strings:Strings.Login_LoginButton}"
                        IsEnabled="{Binding !IsSigningIn}" />
                <Button HorizontalAlignment="Stretch"
                        Command="{Binding LoginWithQuickConnectCommand}"
                        IsVisible="{Binding QuickConnectAvailable}">
                    <StackPanel Orientation="Horizontal"
                                Spacing="8">
                        <mi:MaterialIcon Kind="CellphoneKey" />
                        <TextBlock Text="{x:Static strings:Strings.Login_QuickConnectButton}" />
                    </StackPanel>
                </Button>
                <Button HorizontalAlignment="Stretch"
                        Command="{Binding GoBackCommand}"
                        Content="{x:Static strings:Strings.Back}" />
            </StackPanel>

            <!--  Quick Connect pending  -->
            <Border Classes="panel"
                    IsVisible="{Binding IsQuickConnectActive}">
                <StackPanel Spacing="16">
                    <TextBlock HorizontalAlignment="Center"
                               Classes="caption"
                               Text="{x:Static strings:Strings.Login_QuickConnectCode}" />
                    <TextBlock HorizontalAlignment="Center"
                               FontFamily="Cascadia Mono,Consolas,Menlo,DejaVu Sans Mono,monospace"
                               FontSize="{DynamicResource FontSizeDisplay}"
                               FontWeight="Bold"
                               LetterSpacing="8"
                               Text="{Binding QuickConnectCode}" />
                    <TextBlock Classes="body"
                               Foreground="{DynamicResource OnBackgroundDimBrush}"
                               Text="{x:Static strings:Strings.Login_QuickConnectInstructions}"
                               TextAlignment="Center"
                               TextWrapping="Wrap" />
                    <ProgressBar IsIndeterminate="True" />
                    <Button HorizontalAlignment="Center"
                            controls:PageView.IsInitialFocus="True"
                            Command="{Binding CancelQuickConnectCommand}"
                            Content="{x:Static strings:Strings.Cancel}" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</controls:PageView>
