<Application x:Class="Jellyfin.Avalonia.App"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Jellyfin.Avalonia"
             xmlns:mi="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             Name="Jellyfin"
             RequestedThemeVariant="Dark">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="/Resources/Styles/Theme.axaml" />
                <ResourceInclude Source="/Resources/Templates.axaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>

    <Application.DataTemplates>
        <local:ViewLocator />
    </Application.DataTemplates>

    <Application.Styles>
        <FluentTheme>
            <FluentTheme.Palettes>
                <!--  Design tokens cyan 500 and blue gray 950  -->
                <ColorPaletteResources x:Key="Dark"
                                       Accent="#00A4DD"
                                       AltHigh="#101319"
                                       RegionColor="#101319" />
            </FluentTheme.Palettes>
        </FluentTheme>
        <mi:MaterialIconStyles />
        <StyleInclude Source="/Resources/Styles/Styles.axaml" />
    </Application.Styles>
</Application>
