<Application x:Class="Jellyfin.Avalonia.App"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:icons="https://github.com/oneo-me/fluentui-icons-like"
             xmlns:local="clr-namespace:Jellyfin.Avalonia"
             Name="Jellyfin"
             RequestedThemeVariant="Dark">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="/Resources/Styles/Theme.axaml" />
                <ResourceInclude Source="/Resources/Templates.axaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>

    <Application.DataTemplates>
        <local:ViewLocator />
    </Application.DataTemplates>

    <Application.Styles>
        <FluentTheme>
            <FluentTheme.Palettes>
                <!--  Design tokens cyan 500 and blue gray 950  -->
                <ColorPaletteResources x:Key="Dark"
                                       Accent="#00A4DD"
                                       AltHigh="#101319"
                                       RegionColor="#101319" />
            </FluentTheme.Palettes>
        </FluentTheme>
        <!--  Icons draw with their own brush, so they take the inherited text color like other content  -->
        <Style Selector="icons|FluentIcon">
            <Setter Property="Foreground" Value="{Binding $self.(TextElement.Foreground)}" />
        </Style>
        <StyleInclude Source="/Resources/Styles/Styles.axaml" />
    </Application.Styles>
</Application>
