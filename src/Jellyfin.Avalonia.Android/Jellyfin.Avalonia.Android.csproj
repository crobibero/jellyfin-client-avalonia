<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-android</TargetFramework>
    <SupportedOSPlatformVersion>24.0</SupportedOSPlatformVersion>
    <OutputType>Exe</OutputType>
    <ApplicationId>org.jellyfin.avalonia</ApplicationId>
    <ApplicationTitle>Jellyfin</ApplicationTitle>
    <ApplicationVersion>1</ApplicationVersion>
    <ApplicationDisplayVersion>$(Version)</ApplicationDisplayVersion>
    <AndroidPackageFormat>apk</AndroidPackageFormat>
    <!-- One APK holds all three ABIs; -r builds an APK for one, a third the size. -->
    <RuntimeIdentifiers Condition="'$(RuntimeIdentifier)' == ''">android-arm64;android-arm;android-x64</RuntimeIdentifiers>
  </PropertyGroup>

  <!--
    Release builds compile every method ahead of time. The default profile only covers the .NET runtime, so Avalonia
    and app code were JIT compiled at startup: full AOT starts in 1.7 s instead of 3.1 s, for about 7 MB more per ABI.
    R8 removes the unused AndroidX Java code, and full trimming the unused managed code. libVLC ships libc++ with its
    debug information, which stripping removes.
  -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <AndroidEnableProfiledAot>false</AndroidEnableProfiledAot>
    <TrimMode>full</TrimMode>
    <AndroidLinkTool>r8</AndroidLinkTool>
    <AndroidStripNativeLibraries>true</AndroidStripNativeLibraries>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.Android" />
    <PackageReference Include="VideoLAN.LibVLC.Android" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Jellyfin.Avalonia\Jellyfin.Avalonia.csproj" />
    <ProjectReference Include="..\Jellyfin.Avalonia.LibVlc\Jellyfin.Avalonia.LibVlc.csproj" />
  </ItemGroup>

  <ItemGroup>
    <TrimmerRootAssembly Include="Jellyfin.Avalonia" RootMode="All" />
    <TrimmerRootAssembly Include="Jellyfin.Mvvm" RootMode="All" />
  </ItemGroup>

  <!--
    Libraries that export JNI_OnLoad are loaded when the app starts. LibVLCSharp loads libVLC and calls JNI_OnLoad
    itself on first playback, so its 40 MB stays unloaded until then.
  -->
  <ItemGroup>
    <AndroidNativeLibraryNoJniPreload Include="libvlc.so" />
  </ItemGroup>
</Project>
