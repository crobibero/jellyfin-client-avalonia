<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>$(JellyfinAndroidTargetFramework)</TargetFramework>
    <SupportedOSPlatformVersion>24.0</SupportedOSPlatformVersion>
    <OutputType>Exe</OutputType>
    <ApplicationId>org.jellyfin.avalonia</ApplicationId>
    <ApplicationTitle>Jellyfin</ApplicationTitle>
    <ApplicationVersion>1</ApplicationVersion>
    <ApplicationDisplayVersion>$(Version)</ApplicationDisplayVersion>
    <AndroidPackageFormat>apk</AndroidPackageFormat>
    <RootNamespace>Jellyfin.Avalonia.Android</RootNamespace>
    <RuntimeIdentifiers>android-arm64;android-arm;android-x64</RuntimeIdentifiers>
    <!-- Android heads have no public API surface -->
    <NoWarn>$(NoWarn);CA1515</NoWarn>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <AndroidLinkMode>SdkOnly</AndroidLinkMode>
    <AndroidEnableProfiledAot>true</AndroidEnableProfiledAot>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.Android" />
    <PackageReference Include="VideoLAN.LibVLC.Android" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Jellyfin.Avalonia\Jellyfin.Avalonia.csproj" />
    <ProjectReference Include="..\Jellyfin.Avalonia.LibVlc\Jellyfin.Avalonia.LibVlc.csproj" />
  </ItemGroup>
</Project>
