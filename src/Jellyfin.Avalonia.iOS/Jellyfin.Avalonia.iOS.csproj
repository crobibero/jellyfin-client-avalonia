<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-ios</TargetFramework>
    <SupportedOSPlatformVersion>15.0</SupportedOSPlatformVersion>
    <OutputType>Exe</OutputType>
    <ApplicationId>org.jellyfin.avalonia</ApplicationId>
    <ApplicationTitle>Jellyfin</ApplicationTitle>
    <ApplicationVersion>1</ApplicationVersion>
    <ApplicationDisplayVersion>$(Version)</ApplicationDisplayVersion>
    <ProvisioningType>manual</ProvisioningType>
    <!-- Native libVLC requires the interpreter for some generic code paths -->
    <UseInterpreter>true</UseInterpreter>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.iOS" />
    <PackageReference Include="VideoLAN.LibVLC.iOS" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Jellyfin.Avalonia\Jellyfin.Avalonia.csproj" />
    <ProjectReference Include="..\Jellyfin.Avalonia.LibVlc\Jellyfin.Avalonia.LibVlc.csproj" />
  </ItemGroup>

  <ItemGroup>
    <BundleResource Include="Resources\AppIcon.png" />
    <InterfaceDefinition Include="Resources\LaunchScreen.storyboard" />
  </ItemGroup>
</Project>
