<Project>
    <!-- Sets defaults for all projects in the repo -->
    <PropertyGroup>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <Nullable>enable</Nullable>
        <CodeAnalysisRuleSet>$(MSBuildThisFileDirectory)/jellyfin.ruleset</CodeAnalysisRuleSet>
        <AnalysisMode>AllEnabledByDefault</AnalysisMode>
        <WarningsAsErrors>nullable</WarningsAsErrors>
        <LangVersion>latest</LangVersion>
        <ImplicitUsings>enable</ImplicitUsings>
        <NeutralLanguage>en</NeutralLanguage>
        <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    </PropertyGroup>

    <!-- Shared version and target information -->
    <PropertyGroup>
        <JellyfinTargetFramework>net10.0</JellyfinTargetFramework>
        <JellyfinAndroidTargetFramework>net10.0-android</JellyfinAndroidTargetFramework>
        <JellyfinIOSTargetFramework>net10.0-ios</JellyfinIOSTargetFramework>
        <JellyfinTvOSTargetFramework>net10.0-tvos</JellyfinTvOSTargetFramework>
        <JellyfinBrowserTargetFramework>net10.0-browser</JellyfinBrowserTargetFramework>
        <Version Condition="'$(Version)' == ''">0.1.0</Version>
        <Authors>Jellyfin Contributors</Authors>
        <Product>Jellyfin Avalonia</Product>
    </PropertyGroup>

    <ItemGroup>
        <AdditionalFiles Include="$(MSBuildThisFileDirectory)/stylecop.json" />
    </ItemGroup>

    <!-- Analyzers -->
    <ItemGroup>
        <PackageReference Include="SerilogAnalyzer" PrivateAssets="All" />
        <PackageReference Include="StyleCop.Analyzers" PrivateAssets="All" />
        <PackageReference Include="SmartAnalyzers.MultithreadingAnalyzer" PrivateAssets="All" />
    </ItemGroup>

</Project>
